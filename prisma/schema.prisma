generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  settings    Json
  createdAt   DateTime     @default(now())
  users       User[]
  leads       Lead[]
  credentials Credential[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  ignored     IgnoredThread[]
  scanned     ScannedMessage[]
}

model User {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(MEMBER)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  ownedLeads    Lead[]         @relation("LeadOwner")

  @@index([workspaceId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Lead {
  id                       String          @id @default(cuid())
  workspaceId              String
  workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId               String?
  receivedAt               DateTime
  name                     String
  email                    String
  org                      String          @default("")
  source                   String
  inquiryType              String
  summary                  String          @default("")
  fitScore                 Int
  urgencyScore             Int
  leadScore                Int
  tier                     String
  dealValueLow             Float           @default(0)
  dealValueHigh            Float           @default(0)
  estPayoutRaw             String          @default("")
  winProbability           Float
  winProbabilityOverridden Boolean         @default(false)
  expectedValue            Float
  estWork                  String          @default("")
  recommendedNextStep      String          @default("")
  draftReply               String          @default("")
  fitReasons               Json            @default("[]")
  riskFlags                Json            @default("[]")
  inferredFields           Json            @default("[]")
  stage                    String          @default("New")
  /// True once a human moves the stage — AI re-scores then stop repositioning it.
  stageOverridden          Boolean         @default(false)
  /// The real date the deal's activity happened/is scheduled, pulled from the email content (not the arrival time).
  activityDate             DateTime?
  ownerId                  String?
  owner                    User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  followUpDate             DateTime?
  replySent                Boolean         @default(false)
  lastTouchedAt            DateTime        @default(now())
  notes                    String          @default("")
  /// Cached Zoho CRM matches [{module,id,name,company,email,phone,url}], refreshed by the scan's CRM pass.
  crmRecords               Json            @default("[]")
  crmCheckedAt             DateTime?
  deletedAt                DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  threads                  Thread[]
  timeline                 TimelineEvent[]
  people                   Person[]
  meetings                 Meeting[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, stage])
  @@index([workspaceId, leadScore])
  @@index([workspaceId, followUpDate])
  @@index([workspaceId, receivedAt])
}

model Thread {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject   String
  url       String
  direction String
  date      DateTime
  snippet   String
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

/// A human connected to the lead: whoever reached out, meeting attendees,
/// anyone in the conversation. Auto-maintained by the scanner and the
/// meeting-enrichment pass; email threads hang off the person via Thread.personId.
model Person {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String
  email       String   @default("")
  role        String   @default("")
  phone       String   @default("")
  notes       String   @default("")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  threads     Thread[]

  @@index([leadId])
}

/// A meeting matched to this lead (via attendee emails) from the connected
/// meeting-transcript provider, with its AI dossier/tldr for enrichment.
model Meeting {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  externalId String
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  attendees  Json     @default("[]")
  tldr       String   @default("")
  dossier    String   @default("")
  url        String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([leadId, externalId])
  @@index([leadId])
}

model TimelineEvent {
  id     String   @id @default(cuid())
  leadId String
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   String
  at     DateTime @default(now())
  actor  String
  detail String

  @@index([leadId])
}

model Credential {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind           String
  encryptedValue String
  meta           Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, kind])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      Json      @default("[\"ingest\"]")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  action      String
  target      String
  ip          String?
  at          DateTime  @default(now())

  @@index([workspaceId, at])
}

/// Platform-wide secrets managed only by the developer account
/// (Anthropic API key, Google OAuth client). Not workspace-scoped.
model PlatformCredential {
  id             String   @id @default(cuid())
  kind           String   @unique
  encryptedValue String
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Conversations the scorer judged irrelevant (newsletters, receipts, spam).
/// They never become leads; remembering them here means re-scans skip them
/// without spending AI tokens. This table IS the spam log.
model IgnoredThread {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threadKey   String
  subject     String    @default("")
  fromAddress String    @default("")
  at          DateTime  @default(now())

  @@unique([workspaceId, threadKey])
}

/// Per-email audit log: every message a scan touches ends up here with what
/// happened to it (the scanner's core invariant — nothing silently disappears).
model ScannedMessage {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId    String
  threadRootId String    @default("")
  subject      String    @default("")
  fromEmail    String    @default("")
  receivedAt   DateTime
  /// processed_lead | merged_existing_lead | skipped_irrelevant |
  /// skipped_own_sent | skipped_duplicate | failed_relevance | failed_scoring
  status       String
  decision     String    @default("")
  confidence   Float?
  reason       String    @default("")
  lastError    String    @default("")
  processedAt  DateTime  @default(now()) @updatedAt

  @@unique([workspaceId, messageId])
  @@index([workspaceId, status])
}

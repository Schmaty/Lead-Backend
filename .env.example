# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=production
# Port the API listens on inside the container / host
PORT=8080
# Bind address (leave 0.0.0.0 in Docker)
HOST=0.0.0.0
# Pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the Postgres superuser of the "leadline" database (used by docker compose).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Connection string the API uses. Inside docker compose this is overridden to
# point at the "db" service automatically; this value is used for local dev.
DATABASE_URL=postgresql://leadline:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/leadline

# ── Secrets (generate each one, never reuse, never commit) ───────────────────
# 32-byte key for AES-256-GCM encryption of stored integration secrets.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Signing secret for short-lived access tokens (>= 32 chars).
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Signing secret for invite / password-reset tokens (>= 32 chars, MUST differ
# from JWT_ACCESS_SECRET). Generate: openssl rand -base64 48
JWT_REFRESH_SECRET=

# ── Token lifetimes (formats: 45s, 15m, 12h, 30d) ────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
INVITE_TOKEN_TTL=7d
RESET_TOKEN_TTL=1h

# ── CORS / cookies ───────────────────────────────────────────────────────────
# Origin(s) of the Leadline dashboard, comma-separated. Locked allow-list.
CORS_ORIGIN=https://leadline.yourdomain.com
# Domain the refresh cookie is scoped to. Leave empty for host-only cookies
# (recommended unless the dashboard lives on a sibling subdomain).
COOKIE_DOMAIN=
# lax (default, works for dashboard + api on sibling subdomains) | strict | none
# "none" is required only if the dashboard is on a completely different domain.
COOKIE_SAMESITE=lax
# Refresh cookie Secure flag. Defaults to true in production; set explicitly to
# override (e.g. false for plain-HTTP localhost testing of a production build).
# COOKIE_SECURE=true

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=1m
# Per-IP request ceiling per window for authenticated API traffic
RATE_LIMIT_MAX=120
# Tighter ceiling for auth endpoints (login/signup/reset) per IP per window
AUTH_RATE_LIMIT_MAX=10
# Per-API-key ceiling on the ingest webhook per window
INGEST_RATE_LIMIT_MAX=600

# ── Ingest hardening ─────────────────────────────────────────────────────────
# If true AND the workspace has an N8N_WEBHOOK credential stored, the ingest
# endpoint requires an x-signature header (HMAC-SHA256 of the raw body).
INGEST_HMAC_ENABLED=false

# ── Backups (used by the docker "backup" service) ────────────────────────────
# Passphrase for GPG-encrypting nightly pg_dump archives.
# Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
# Cron expression for when the nightly dump runs (container-local time, UTC)
BACKUP_CRON=15 2 * * *

# ── Email (optional) ─────────────────────────────────────────────────────────
# smtp://user:pass@host:587 — enables emailed invites & password resets.
# When empty, invite links are returned by the API and reset links are written
# to the server log instead.
SMTP_URL=
SMTP_FROM=Leadline <no-reply@yourdomain.com>

# ── Edge profiles (docker compose) ───────────────────────────────────────────
# Used by the "domain" profile (Caddy auto-HTTPS)
LEADLINE_DOMAIN=api.yourdomain.com
# Used by the "home" profile (Cloudflare Tunnel) — token from the Zero Trust
# dashboard, see README §Expose it
CLOUDFLARE_TUNNEL_TOKEN=

{
  "name": "leadline-api",
  "version": "1.0.0",
  "private": true,
  "description": "Leadline API — multi-tenant lead-management backend (stores, secures, serves)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.3",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
